# Android fstab file.
# <src>                                                 <mnt_point> <type> <mnt_flags and options> <fs_mgr_flags>
/dev/block/platform/13540000.dwmmc0/by-name/BOOT       /boot       emmc   defaults                defaults
/dev/block/platform/13540000.dwmmc0/by-name/RECOVERY   /recovery   emmc   defaults                defaults
/dev/block/platform/13540000.dwmmc0/by-name/OTA        /misc       emmc   defaults                defaults
/dev/block/platform/13540000.dwmmc0/by-name/SYSTEM     /system     ext4   defaults                defaults
/dev/block/platform/13540000.dwmmc0/by-name/VENDOR     /vendor     ext4   defaults                defaults
/dev/block/platform/13540000.dwmmc0/by-name/CACHE      /cache      ext4   noatime,nosuid,nodev    defaults
/dev/block/platform/13540000.dwmmc0/by-name/USERDATA   /data       ext4   noatime,nosuid,nodev    fileencryption=ice
/dev/block/platform/13540000.dwmmc0/by-name/EFS        /efs        ext4   noatime,nosuid,nodev    defaults
/dev/block/platform/13540000.dwmmc0/by-name/CPEFS      /cpefs      ext4   noatime,nosuid,nodev    defaults
/dev/block/platform/13540000.dwmmc0/by-name/RADIO      /modem      emmc   defaults                defaults
